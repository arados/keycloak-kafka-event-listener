<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
        False positive: our plugin artifacts (hr.delmisoft.keycloak:keycloak-kafka-event-listener)
        are heuristically matched by OWASP's CPE analyzer against any CPE whose product is
        "keycloak" because the artifactIds contain that substring. Those CVEs are in the
        Keycloak server itself, not in our plugin. Same suppression as keycloak-otp.

        Do NOT suppress kafka-clients / lz4-java findings here without analysis: we ship those
        libraries inside the shaded JAR (zstd-jni and snappy-java are no longer bundled, see
        docs/PLAN.md D4; users who add them to providers/ own their patching).
    -->
    <suppress>
        <notes>CPE name-collision: our plugin artifacts are not Keycloak server.</notes>
        <packageUrl regex="true">^pkg:maven/hr\.delmisoft\.keycloak/keycloak-kafka-event-listener@.*$</packageUrl>
        <cpe>cpe:/a:redhat:keycloak</cpe>
        <cpe>cpe:/a:keycloak:keycloak</cpe>
    </suppress>

</suppressions>
