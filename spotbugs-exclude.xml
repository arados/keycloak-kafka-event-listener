<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Add narrowly scoped exclusions here, each with a comment explaining why the finding
         is a false positive. Never exclude a pattern project-wide. -->

    <!-- Keycloak creates one provider per KeycloakSession and the provider must hold that
         session to use it (realm lookups in onEvent, enlisting the after-commit transaction).
         Storing the caller's mutable session is the SPI contract, not a leak. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="hr.delmisoft.keycloak.kafka.KafkaEventListenerProvider"/>
        <Method name="&lt;init&gt;"/>
    </Match>

    <!-- Same contract for the outbox repository: one instance per KeycloakSession, which it needs to reach the
         session's EntityManager. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="hr.delmisoft.keycloak.kafka.outbox.KeycloakOutboxRepository"/>
        <Method name="&lt;init&gt;"/>
    </Match>

    <!-- The outbox hands its thread-safe, stateless OutboxWriter to every provider; sharing it is the point. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Class name="hr.delmisoft.keycloak.kafka.outbox.KafkaOutbox"/>
        <Method name="writer"/>
    </Match>
</FindBugsFilter>
