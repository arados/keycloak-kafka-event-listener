<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>hr.delmisoft.keycloak</groupId>
    <artifactId>keycloak-kafka-event-listener</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Keycloak Kafka Event Listener</name>
    <description>Keycloak event listener SPI that publishes user and admin events to Apache Kafka.
        The shaded JAR is the deployable: drop it into Keycloak's providers/ directory.</description>
    <url>https://github.com/arados/keycloak-kafka-event-listener</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/arados/keycloak-kafka-event-listener.git</connection>
        <developerConnection>scm:git:git@github.com:arados/keycloak-kafka-event-listener.git</developerConnection>
        <url>https://github.com/arados/keycloak-kafka-event-listener</url>
    </scm>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <keycloak.version>26.8.1</keycloak.version>
        <kafka.version>4.4.0</kafka.version>
        <!-- The micrometer-core Keycloak ships (lib/lib/main); provided at runtime, never bundled. -->
        <micrometer.version>1.17.1</micrometer.version>
    </properties>

    <dependencies>
        <!-- Provided by the Keycloak server at runtime. -->
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-server-spi</artifactId>
            <version>${keycloak.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-server-spi-private</artifactId>
            <version>${keycloak.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-services</artifactId>
            <version>${keycloak.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-core</artifactId>
            <version>${keycloak.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- delivery-mode=outbox: Keycloak-internal classes (OutboxStore and its OUTBOX_ENTRY entity in model-jpa,
             ClusterAwareScheduledTaskRunner in model-storage-private). Only outbox.KeycloakOutboxRepository and
             outbox.KafkaOutbox touch them; re-check on every Keycloak bump (bump-keycloak skill). -->
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-model-jpa</artifactId>
            <version>${keycloak.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-model-storage-private</artifactId>
            <version>${keycloak.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Metrics: Keycloak's Micrometer global registry, exposed on its /metrics endpoint. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <version>${micrometer.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Not shipped by Keycloak: bundled into the shaded JAR (see maven-shade-plugin below).
             Only the lz4 codec comes along (see README "Compression"): zstd-jni and snappy-java are
             mostly native libraries for ~20 platforms that they extract to java.io.tmpdir at runtime.
             Excluded here (not just from the shade) so unit tests run without them, exactly like the
             deployed JAR. Users who want compression.type=zstd|snappy add those JARs to providers/. -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>${kafka.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>com.github.luben</groupId>
                    <artifactId>zstd-jni</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.xerial.snappy</groupId>
                    <artifactId>snappy-java</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Test dependencies -->
        <!-- A JAX-RS RuntimeDelegate for jakarta.ws.rs.core.UriBuilder, which Keycloak's Urls.realmIssuer
             (the envelope `source`, decision D2) uses. Keycloak brings its own at runtime; unit tests need
             one on the classpath. Same choice as keycloak-otp's otp-login module. -->
        <dependency>
            <groupId>org.jboss.resteasy</groupId>
            <artifactId>resteasy-core</artifactId>
            <version>6.2.19.Final</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.24.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.24.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
            <version>3.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!-- Keycloak 26.8.1 already ships slf4j-api (2.0.x), jackson and micrometer;
                                 it does NOT ship kafka-clients or the compression codecs. Bundle only
                                 what Keycloak lacks, and of the codecs only lz4 (D4; zstd-jni and
                                 snappy-java are excluded on the dependency above). Re-check with the
                                 bump-keycloak skill on every Keycloak upgrade. -->
                            <artifactSet>
                                <includes>
                                    <include>org.apache.kafka:kafka-clients</include>
                                    <include>at.yawk.lz4:lz4-java</include>
                                </includes>
                            </artifactSet>
                            <filters>
                                <!-- lz4-java's JNI libraries are unreachable under Keycloak: its
                                     LZ4Factory/XXHashFactory.fastestInstance() only try JNI when the
                                     library sits on the system classloader (providers don't), else they
                                     use the pure-Java implementation. Dropping them means nothing is
                                     ever extracted to java.io.tmpdir and no native code is shipped. -->
                                <filter>
                                    <artifact>at.yawk.lz4:lz4-java</artifact>
                                    <excludes>
                                        <exclude>net/jpountz/util/*/*/liblz4-java.*</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>4.10.5.0</version>
                    <configuration>
                        <plugins>
                            <plugin>
                                <groupId>com.h3xstream.findsecbugs</groupId>
                                <artifactId>findsecbugs-plugin</artifactId>
                                <version>1.14.0</version>
                            </plugin>
                        </plugins>
                        <excludeFilterFile>${project.basedir}/spotbugs-exclude.xml</excludeFilterFile>
                        <effort>Max</effort>
                        <threshold>Medium</threshold>
                        <failOnError>true</failOnError>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>13.0.0</version>
                    <configuration>
                        <failBuildOnCVSS>7</failBuildOnCVSS>
                        <!-- keycloak-* and their transitive libs are provided by the Keycloak
                             container at runtime. kafka-clients and lz4-java are compile/runtime
                             scope, so they ARE scanned: we ship them. -->
                        <skipProvidedScope>true</skipProvidedScope>
                        <skipTestScope>true</skipTestScope>
                        <suppressionFiles>
                            <suppressionFile>dependency-check-suppressions.xml</suppressionFile>
                        </suppressionFiles>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Playwright end-to-end tests in e2e/. `mvn verify -P e2e` manages the docker compose
             lifecycle (always with the `secure` profile): compose down, compose up (rebuilding the images),
             wait, npm ci, playwright, compose down. -->
        <profile>
            <id>e2e</id>
            <properties>
                <e2e.dir>${project.basedir}/e2e</e2e.dir>
                <e2e.keycloak.url>http://localhost:8080</e2e.keycloak.url>
                <e2e.realm>kafka-demo</e2e.realm>
                <e2e.readiness.url>${e2e.keycloak.url}/realms/${e2e.realm}/.well-known/openid-configuration</e2e.readiness.url>
                <!-- keycloak-secure, compose profile `secure` (SASL_SSL/SCRAM broker, zstd) -->
                <e2e.readiness.secureUrl>http://localhost:8082/realms/${e2e.realm}/.well-known/openid-configuration</e2e.readiness.secureUrl>
                <e2e.readiness.maxAttempts>90</e2e.readiness.maxAttempts>
                <e2e.readiness.sleepSeconds>2</e2e.readiness.sleepSeconds>
                <e2e.exitCodeFile>${project.build.directory}/e2e-exit-code.txt</e2e.exitCodeFile>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <!-- Bring up Keycloak + Kafka and wait for Keycloak readiness (compose waits for Kafka health) -->
                            <execution>
                                <id>e2e-docker-up</id>
                                <phase>pre-integration-test</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <echo message="==&gt; Tearing down any existing stack" />
                                        <exec executable="docker" dir="${project.basedir}" failonerror="false">
                                            <arg value="compose" />
                                            <arg value="--profile" />
                                            <arg value="secure" />
                                            <arg value="down" />
                                            <arg value="-v" />
                                        </exec>

                                        <echo message="==&gt; Building and starting docker compose stack" />
                                        <exec executable="docker" dir="${project.basedir}" failonerror="true">
                                            <arg value="compose" />
                                            <arg value="--profile" />
                                            <arg value="secure" />
                                            <arg value="up" />
                                            <arg value="--build" />
                                            <arg value="-d" />
                                        </exec>

                                        <echo message="==&gt; Waiting for Keycloak readiness at ${e2e.readiness.url}" />
                                        <exec executable="sh" failonerror="true">
                                            <arg value="-c" />
                                            <arg value="for i in $(seq 1 ${e2e.readiness.maxAttempts}); do curl -sf ${e2e.readiness.url} &gt;/dev/null 2&gt;&amp;1 &amp;&amp; echo &quot;ready after $((i*${e2e.readiness.sleepSeconds}))s&quot; &amp;&amp; exit 0; sleep ${e2e.readiness.sleepSeconds}; done; echo &quot;Keycloak did not become ready in time&quot;; exit 1" />
                                        </exec>

                                        <echo message="==&gt; Waiting for keycloak-secure readiness at ${e2e.readiness.secureUrl}" />
                                        <exec executable="sh" failonerror="true">
                                            <arg value="-c" />
                                            <arg value="for i in $(seq 1 ${e2e.readiness.maxAttempts}); do curl -sf ${e2e.readiness.secureUrl} &gt;/dev/null 2&gt;&amp;1 &amp;&amp; echo &quot;ready after $((i*${e2e.readiness.sleepSeconds}))s&quot; &amp;&amp; exit 0; sleep ${e2e.readiness.sleepSeconds}; done; echo &quot;keycloak-secure did not become ready in time&quot;; exit 1" />
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>

                            <!-- Install npm deps + Playwright browsers, then run the tests.
                                 failonerror=false on the test step so post-integration-test still runs (docker down).
                                 The verify execution below promotes the recorded exit code into a build failure. -->
                            <execution>
                                <id>e2e-run-tests</id>
                                <phase>integration-test</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <echo message="==&gt; npm ci" />
                                        <exec executable="npm" dir="${e2e.dir}" failonerror="true">
                                            <arg value="ci" />
                                        </exec>

                                        <echo message="==&gt; Installing Playwright Chromium" />
                                        <exec executable="npx" dir="${e2e.dir}" failonerror="true">
                                            <arg value="playwright" />
                                            <arg value="install" />
                                            <arg value="chromium" />
                                        </exec>

                                        <echo message="==&gt; Running Playwright tests" />
                                        <mkdir dir="${project.build.directory}" />
                                        <exec executable="npx" dir="${e2e.dir}" failonerror="false" resultproperty="e2e.exit">
                                            <arg value="playwright" />
                                            <arg value="test" />
                                        </exec>
                                        <echo file="${e2e.exitCodeFile}" message="${e2e.exit}" />
                                    </target>
                                </configuration>
                            </execution>

                            <!-- Always tear the stack down, even if tests failed. -->
                            <execution>
                                <id>e2e-docker-down</id>
                                <phase>post-integration-test</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <echo message="==&gt; Tearing down docker compose stack" />
                                        <exec executable="docker" dir="${project.basedir}" failonerror="false">
                                            <arg value="compose" />
                                            <arg value="--profile" />
                                            <arg value="secure" />
                                            <arg value="down" />
                                            <arg value="-v" />
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>

                            <!-- Propagate the recorded Playwright exit code into a build failure. -->
                            <execution>
                                <id>e2e-verify</id>
                                <phase>verify</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <loadfile property="e2e.exit.recorded" srcFile="${e2e.exitCodeFile}" />
                                        <fail message="Playwright E2E tests failed (exit code ${e2e.exit.recorded})">
                                            <condition>
                                                <not>
                                                    <equals arg1="${e2e.exit.recorded}" arg2="0" trim="true" />
                                                </not>
                                            </condition>
                                        </fail>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
