<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>hr.delmisoft.keycloak</groupId>
        <artifactId>keycloak-kafka-events-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>keycloak-kafka-events</artifactId>
    <packaging>jar</packaging>
    <description>Single deployable JAR — drop into Keycloak providers/ directory</description>

    <dependencies>
        <dependency>
            <groupId>hr.delmisoft.keycloak</groupId>
            <artifactId>keycloak-kafka-events-listener</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!-- Keycloak 26.8.1 already ships slf4j-api (2.0.x), jackson and micrometer;
                                 it does NOT ship kafka-clients or the compression codecs. Bundle only
                                 what Keycloak lacks. Re-check with the bump-keycloak skill on every
                                 Keycloak upgrade (see docs/RESEARCH.md "Keycloak runtime libraries"). -->
                            <artifactSet>
                                <includes>
                                    <include>hr.delmisoft.keycloak:*</include>
                                    <include>org.apache.kafka:kafka-clients</include>
                                    <include>com.github.luben:zstd-jni</include>
                                    <include>at.yawk.lz4:lz4-java</include>
                                    <include>org.xerial.snappy:snappy-java</include>
                                </includes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
